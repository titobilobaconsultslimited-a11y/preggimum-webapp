# PreggiMum Environment Variables Template
# Copy to .env and replace placeholders with your actual secrets

# Neon PostgreSQL Database Connection
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"

# JWT Secret for Patient Authentication
JWT_SECRET="your-secure-jwt-secret-key"

# Paystack API Keys (when merchant gateway is ready)
# PAYSTACK_SECRET_KEY="sk_test_xxx"
# PAYSTACK_PUBLIC_KEY="pk_test_xxx"

# Frontend API URL
VITE_API_URL="/api"
